OPENAI_API_KEY=

DEFAULT_MODEL_NAME=gpt-5.4
NOTIFY_MODEL_NAME=gpt-5.4-mini
# Number of web searches (hard limit of 5 in code)
HOW_MANY_SEARCHES=5
# Annual risk-free rate for the Sharpe ratio, as a decimal (0.04 = 4%)
RISK_FREE_RATE=0.0

# EODHD (eodhd.com) key, to download fund and benchmark prices by ISIN or ticker (optional)
EODHD_API_KEY=

# Password-protect the app (recommended for a public link; leave blank locally)
APP_USERNAME=
APP_PASSWORD=
# Max reports running at the same time
MAX_CONCURRENT_RUNS=2

# Email via Resend (recommended; works on Render's free plan, which blocks SMTP email ports)
RESEND_API_KEY=
# Sender. Leave blank to use Resend's test sender, which only delivers to your Resend account's email.
# To send anywhere else, verify a domain in Resend and use e.g. Fund Report <reports@yourdomain.com>
EMAIL_FROM=

# Email via SMTP instead (used only when RESEND_API_KEY is blank; leave blank to skip; the agent reports it as skipped)
EMAIL_ADDRESS=
EMAIL_SMTP_SERVER=
EMAIL_APP_PASSWORD=
# Where reports go, comma-separated (e.g. me@work.com, colleague@work.com); blank sends to EMAIL_ADDRESS
EMAIL_TO=

# Pushover (leave blank to skip)
PUSHOVER_USER=
PUSHOVER_TOKEN=

# --- Fund Performance Agent (src/fund_performance) ---
# Emailing the report is off by default; turn it on and set recipients in config/settings.yaml.
# SMTP login for that email (never put these in config files):
FUND_SMTP_USER=
FUND_SMTP_PASSWORD=
# Optional, for testing one agent on another model listed in config/models.yaml, e.g. FUND_MODEL_EVALUATOR=gpt-5.4
