# Copy to .env (gitignored) and fill in. Never commit .env or put a key in code, tests, docs or commits.
# Data sharing is on for this API key: public data only, never upload confidential or client data.
OPENAI_API_KEY=

# Optional: password-protect the web page (recommended for a public link; leave blank locally)
APP_USERNAME=
APP_PASSWORD=
# Reviews running at the same time
MAX_CONCURRENT_RUNS=2

# Optional: email the report through Resend (HTTPS; Render's free plan blocks SMTP ports).
# Off by default: turn it on and set the recipients in config/settings.yaml.
RESEND_API_KEY=
# Sender, e.g. Fund Report <reports@yourdomain.com> (a domain verified in Resend). Blank: Resend's test
# sender, which only delivers to your Resend account's own address.
EMAIL_FROM=

# Optional, for testing one agent on another model listed in config/models.yaml, e.g. FUND_MODEL_EVALUATOR=gpt-5.4
