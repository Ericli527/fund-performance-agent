# Copy to .env (gitignored) and fill in. Never commit .env or put a key in code, tests, docs or commits.
# Data sharing is on for this API key: public data only, never upload confidential or client data.
OPENAI_API_KEY=

# The web page's login: the page asks for these before it opens (recommended for a public link; leave blank
# locally). On a server with no login set up, AI runs are switched off and only the offline demo works.
APP_USERNAME=
APP_PASSWORD=
# The AI switch: AI runs (reading documents, Live AI Demo, AI text) happen only when this is true. Off when unset.
# On your own computer set it to true to use AI; on a server the login above is needed as well.
AI_RUNS_ENABLED=false
# Reviews the page handles at the same time, offline runs included (AI runs: config/settings.yaml, web)
MAX_CONCURRENT_RUNS=2
# Development and testing only: run every review without AI (the page has no Offline switch)
# FUND_REVIEW_OFFLINE=1

# Optional: email the report through Resend (HTTPS; Render's free plan blocks SMTP ports).
# Off by default: turn it on in config/settings.yaml (email.enabled) and set EMAIL_TO below.
RESEND_API_KEY=
# Sender, e.g. Fund Report <reports@yourdomain.com> (a domain verified in Resend). Blank: Resend's test
# sender, which only delivers to your Resend account's own address.
EMAIL_FROM=
# Recipients, comma-separated (kept here, not in the public repository)
EMAIL_TO=

# Optional, for testing one agent on another model listed in config/models.yaml, e.g. FUND_MODEL_EVALUATOR=gpt-5.4
